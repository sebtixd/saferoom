# Copy/export these before running the backend.
# Nothing is required for local development; these are production overrides.

# HTTP server
PORT=3000
HOST=0.0.0.0

# SQLite database file (created automatically)
SAFEROOM_DB_PATH=./backend/data/saferoom.db

# Secret used to sign access tokens.
# If omitted, a random secret is generated once and stored in backend/data/jwt_secret.
# ALWAYS set this explicitly in production (at least 32 characters).
# SAFEROOM_JWT_SECRET=replace-with-a-long-random-secret

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allowed origins for CORS, or *
SAFEROOM_ALLOWED_ORIGINS=*

# Dev only: include the password-reset token in the API response so it can be tested
# without an email provider. Never enable in production.
# SAFEROOM_EXPOSE_RESET_TOKENS=true
